generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  password      String
  role          String         @default("customer")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastLogin     DateTime?
  isActive      Boolean        @default(true)
  achievements  Achievement[]
  blogPosts     BlogPost[]
  courses       Course[]
  healthMetrics HealthMetric[]
  quizResults   QuizResult[]
  chatMessages  ChatMessage[]
  healthProfile HealthProfile?
  symptomAnalyses SymptomAnalysis[]
  purchases     Purchase[]
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String
  level       String
  duration    String
  progress    Int      @default(0)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Achievement {
  id          String    @id @default(uuid())
  title       String
  description String
  icon        String
  earned      Boolean   @default(false)
  earnedAt    DateTime?
  userId      String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
}

model HealthMetric {
  id        String   @id @default(uuid())
  type      String
  value     Float
  date      DateTime @default(now())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String
  imageUrl    String
  imageAlt    String
  metaTitle   String
  metaDesc    String
  status      String
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
}

model QuizResult {
  id          String   @id @default(uuid())
  answers     Json     // Lagrar quiz-svaren som JSON
  results     Json     // Lagrar AI-genererade resultat
  healthScore Int      // Total hälsopoäng 0-100
  energyScore Int      // Energi 0-10
  sleepScore  Int      // Sömn 0-10
  stressScore Int      // Stress 0-10
  dietScore   Int      // Kost 0-10
  exerciseScore Int    // Motion 0-10
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        String   @id @default(uuid())
  message   String
  response  String
  context   Json?    // Lagrar kontext (quiz-resultat, symptomanalys etc)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model HealthProfile {
  id                String   @id @default(uuid())
  age               Int?
  gender            String?
  weight            Float?
  height            Float?
  activityLevel     String?
  dietaryRestrictions String?
  healthGoals       Json?    // Array av hälsomål
  currentSymptoms   Json?    // Array av nuvarande symptom
  medications       Json?    // Array av mediciner
  supplements       Json?    // Array av kosttillskott
  allergies         Json?    // Array av allergier
  userId            String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}

model SymptomAnalysis {
  id          String   @id @default(uuid())
  bodyPart    String
  description String
  analysis    Json     // AI-genererad analys
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model CourseProduct {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  price       Float
  content     Json     // Stores videos, pdfs, etc.
  features    Json     // List of features included
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchases   Purchase[]
}

model Purchase {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  courseId   String
  course     CourseProduct @relation(fields: [courseId], references: [id])
  amount     Float
  status     String   @default("completed") // completed, pending, refunded
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([userId, courseId])
}
