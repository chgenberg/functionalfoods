generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  password      String
  role          String         @default("customer")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastLogin     DateTime?
  isActive      Boolean        @default(true)
  achievements  Achievement[]
  blogPosts     BlogPost[]
  courses       Course[]
  healthMetrics HealthMetric[]
  quizResults   QuizResult[]
  chatMessages  ChatMessage[]
  healthProfile HealthProfile?
  symptomAnalyses SymptomAnalysis[]
  purchases     Purchase[]
  orders        Order[]
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String
  level       String
  duration    String
  progress    Int      @default(0)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Achievement {
  id          String    @id @default(uuid())
  title       String
  description String
  icon        String
  earned      Boolean   @default(false)
  earnedAt    DateTime?
  userId      String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
}

model HealthMetric {
  id        String   @id @default(uuid())
  type      String
  value     Float
  date      DateTime @default(now())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model BlogPost {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  content      String
  excerpt      String?
  coverImage   String?
  published    Boolean  @default(false)
  publishedAt  DateTime?
  authorId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       User     @relation(fields: [authorId], references: [id])
}

model QuizResult {
  id              String   @id @default(uuid())
  userId          String
  healthScore     Int
  energyScore     Int
  sleepScore      Int
  stressScore     Int
  dietScore       Int
  exerciseScore   Int
  recommendations Json     // Array av rekommendationer
  completedAt     DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  message   String
  response  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model HealthProfile {
  id                String   @id @default(uuid())
  age               Int?
  gender            String?
  weight            Float?
  height            Float?
  activityLevel     String?
  dietaryRestrictions String?
  healthGoals       Json?    // Array av hälsomål
  currentSymptoms   Json?    // Array av nuvarande symptom
  medications       Json?    // Array av mediciner
  supplements       Json?    // Array av kosttillskott
  allergies         Json?    // Array av allergier
  userId            String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}

model SymptomAnalysis {
  id          String   @id @default(uuid())
  bodyPart    String
  description String
  analysis    Json     // AI-genererad analys
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model CourseProduct {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  price       Float
  content     Json     // Stores videos, pdfs, etc.
  features    Json     // List of features included
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchases   Purchase[]
  orderItems  OrderItem[]
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique // Human readable order number
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING)
  totalAmount   Float
  currency      String      @default("SEK")
  items         OrderItem[]
  payment       Payment?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@index([userId])
  @@index([orderNumber])
}

model OrderItem {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courseId    String?
  course      CourseProduct? @relation(fields: [courseId], references: [id])
  name        String        // Store name for historical purposes
  price       Float         // Store price at time of purchase
  quantity    Int
  type        String        // 'course', 'book', etc.
  createdAt   DateTime      @default(now())
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod   String        // 'klarna', 'swish', 'stripe', etc.
  status          PaymentStatus @default(PENDING)
  amount          Float
  currency        String        @default("SEK")
  externalId      String?       // Payment provider's transaction ID
  gatewayResponse Json?         // Store full response from payment gateway
  failureReason   String?       // If payment failed
  processedAt     DateTime?     // When payment was completed
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([externalId])
  @@index([status])
}

model Purchase {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  courseId   String
  course     CourseProduct @relation(fields: [courseId], references: [id])
  amount     Float
  status     String   @default("completed") // completed, pending, refunded
  orderId    String?  // Link to new Order system
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([userId, courseId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}
