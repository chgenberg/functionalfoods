generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  name              String?
  role              String            @default("customer")
  createdAt         DateTime          @default(now())
  password          String
  updatedAt         DateTime          @updatedAt
  lastLogin         DateTime?
  isActive          Boolean           @default(true)
  addressLine1      String?
  addressLine2      String?
  city              String?
  country           String?
  postalCode        String?
  nationality       String?
  preferredLanguage Language?         @default(SV)
  achievements      Achievement[]
  blogPosts         BlogPost[]
  chatMessages      ChatMessage[]
  courses           Course[]
  courseReviews     CourseReview[]
  forumLikes        ForumLike[]
  forumReplies      ForumReply[]
  forumThreads      ForumThread[]
  goals             Goal[]
  healthMetrics     HealthMetric[]
  healthProfile     HealthProfile?
  mealProgress      MealProgress[]
  orders            Order[]
  purchases         Purchase[]
  quizResults       QuizResult[]
  recipes           Recipe[]
  symptomAnalyses   SymptomAnalysis[]
  passwordResets    PasswordReset[]
}

model Course {
  id                   String   @id @default(uuid())
  title                String
  description          String
  level                String
  duration             String
  progress             Int      @default(0)
  userId               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  communityDescription String?
  coverImage           String?
  downloads            Json?
  enableCommunity      Boolean  @default(false)
  introVideoUrl        String?
  materials            Json?
  metadata             Json?
  objectives           String[]
  price                Float?
  targetAudience       String?
  weeks                Json?
  welcomeMessage       String?
  user                 User     @relation(fields: [userId], references: [id])
}

model Achievement {
  id          String    @id @default(uuid())
  title       String
  description String
  icon        String
  earned      Boolean   @default(false)
  earnedAt    DateTime?
  userId      String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
}

model HealthMetric {
  id        String   @id @default(uuid())
  type      String
  value     Float
  date      DateTime @default(now())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    String
  coverImage  String?
  excerpt     String?
  published   Boolean   @default(false)
  searchText  String?
  content_de  String?
  content_en  String?
  content_es  String?
  content_fr  String?
  excerpt_de  String?
  excerpt_en  String?
  excerpt_es  String?
  excerpt_fr  String?
  title_de    String?
  title_en    String?
  title_es    String?
  title_fr    String?
  author      User      @relation(fields: [authorId], references: [id])

  @@index([searchText])
}

model QuizResult {
  id              String   @id @default(uuid())
  healthScore     Int
  energyScore     Int
  sleepScore      Int
  stressScore     Int
  dietScore       Int
  exerciseScore   Int
  userId          String
  completedAt     DateTime @default(now())
  recommendations Json
  user            User     @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        String   @id @default(uuid())
  message   String
  response  String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model HealthProfile {
  id                  String   @id @default(uuid())
  age                 Int?
  gender              String?
  weight              Float?
  height              Float?
  activityLevel       String?
  dietaryRestrictions String?
  healthGoals         Json?
  currentSymptoms     Json?
  medications         Json?
  supplements         Json?
  allergies           Json?
  userId              String   @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id])
}

model SymptomAnalysis {
  id          String   @id @default(uuid())
  bodyPart    String
  description String
  analysis    Json
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model CourseProduct {
  id            String               @id @default(uuid())
  name          String               @unique
  description   String
  price         Float
  content       Json
  features      Json
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  orderItems    OrderItem[]
  purchases     Purchase[]
  shoppingLists WeeklyShoppingList[]
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  userId      String
  status      OrderStatus @default(PENDING)
  totalAmount Float
  currency    String      @default("SEK")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payment     Payment?

  @@index([userId])
  @@index([orderNumber])
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  courseId  String?
  name      String
  price     Float
  quantity  Int
  type      String
  createdAt DateTime       @default(now())
  course    CourseProduct? @relation(fields: [courseId], references: [id])
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique
  paymentMethod   String
  status          PaymentStatus @default(PENDING)
  amount          Float
  currency        String        @default("SEK")
  externalId      String?
  gatewayResponse Json?
  failureReason   String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([externalId])
  @@index([status])
}

model Purchase {
  id              String        @id @default(uuid())
  userId          String
  courseId        String
  amount          Float
  status          String        @default("completed")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orderId         String?
  accessExpiresAt DateTime?
  course          CourseProduct @relation(fields: [courseId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

model Goal {
  id          String    @id @default(uuid())
  title       String
  description String?
  category    String
  priority    String    @default("medium")
  status      String    @default("active")
  progress    Int       @default(0)
  targetDate  DateTime?
  completedAt DateTime?
  weekNumber  Int?
  courseId    String?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([weekNumber])
}

model MealProgress {
  id          String   @id @default(uuid())
  userId      String
  courseType  String   // 'basics' or 'flow'
  weekNumber  Int
  dayNumber   Int
  mealIndex   Int      // Index of the meal in the day's meal array
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseType, weekNumber, dayNumber, mealIndex])
  @@index([userId])
  @@index([courseType])
  @@index([weekNumber])
}

model ForumCategory {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  color       String        @default("gray")
  icon        String?
  order       Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  threads     ForumThread[]
}

model ForumThread {
  id         String        @id @default(uuid())
  title      String
  content    String
  isSticky   Boolean       @default(false)
  isLocked   Boolean       @default(false)
  views      Int           @default(0)
  authorId   String
  categoryId String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  likes      ForumLike[]
  replies    ForumReply[]
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt])
}

model ForumReply {
  id        String       @id @default(uuid())
  content   String
  authorId  String
  threadId  String
  parentId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  likes     ForumLike[]
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    ForumReply?  @relation("ReplyToReply", fields: [parentId], references: [id], onDelete: Cascade)
  children  ForumReply[] @relation("ReplyToReply")
  thread    ForumThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([authorId])
  @@index([parentId])
}

model ForumLike {
  id        String       @id @default(uuid())
  userId    String
  threadId  String?
  replyId   String?
  createdAt DateTime     @default(now())
  reply     ForumReply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)
  thread    ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@unique([userId, replyId])
  @@index([userId])
}

model Recipe {
  id              String       @id @default(uuid())
  title           String
  slug            String       @unique
  excerpt         String?
  content         String?
  imageUrl        String?
  imageAlt        String?
  categories      String[]
  ingredients     String[]
  instructions    String?
  difficulty      String?
  prepTime        String?
  cookTime        String?
  totalTime       String?
  servings        Int?
  nutrition       Json?
  tips            String?
  tags            String[]
  status          RecipeStatus @default(PUBLISHED)
  isPremium       Boolean      @default(false)
  isFree          Boolean      @default(true)
  authorId        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  searchText      String?
  excerpt_de      String?
  excerpt_en      String?
  excerpt_es      String?
  excerpt_fr      String?
  instructions_de String?
  instructions_en String?
  instructions_es String?
  instructions_fr String?
  title_de        String?
  title_en        String?
  title_es        String?
  title_fr        String?
  imageMobileUrl  String?
  ingredientsStructured Json?
  author          User?        @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([isPremium])
  @@index([isFree])
  @@index([slug])
  @@index([searchText])
}

model WeeklyShoppingList {
  id        String             @id @default(uuid())
  courseId  String
  week      Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  items     ShoppingListItem[]
  course    CourseProduct      @relation(fields: [courseId], references: [id])

  @@unique([courseId, week])
}

model ShoppingListItem {
  id         String             @id @default(uuid())
  listId     String
  ingredient String
  isChecked  Boolean            @default(false)
  list       WeeklyShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
}

model RawMaterial {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  imageUrl       String?
  imageAlt       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  description_de String?
  description_en String?
  description_es String?
  description_fr String?
  name_de        String?
  name_en        String?
  name_es        String?
  name_fr        String?
}

model Coupon {
  id                  String    @id @default(uuid())
  code                String    @unique
  type                String
  amount              Float
  active              Boolean   @default(true)
  startsAt            DateTime?
  expiresAt           DateTime?
  usageLimit          Int?
  timesUsed           Int       @default(0)
  applicableCourseIds Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([code])
  @@index([active])
}

model CourseReview {
  id        String       @id @default(uuid())
  userId    String
  courseId  String
  rating    Int?
  answers   Json
  consent   Boolean      @default(false)
  category  String       @default("course-feedback")
  source    ReviewSource @default(IN_APP)
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([status])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewSource {
  IN_APP
  EMAIL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Language {
  SV
  EN
  ES
  DE
  FR
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@index([expiresAt])
}

model PageConfiguration {
  id         String   @id @default(uuid())
  pageId     String   @unique
  components Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([pageId])
}

model SiteSettings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  type        String   @default("text") // text, boolean, number, json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([key])
}

model KnowledgeDocument {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  content       String
  headerImage   String?
  relatedImages Json?
  keyTakeaways  Json?
  readTime      Int      @default(5)
  course        String   // 'basic' | 'flow'
  order         Int      @default(0)
  weekNumber    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([course])
  @@index([order])
}

model MealPlanWeek {
  id         String   @id @default(uuid())
  course     String   // 'basic' | 'flow' | 'energy'
  weekNumber Int
  title      String?
  days       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([course, weekNumber])
  @@index([course])
}

model CourseWeekMeta {
  id          String   @id @default(uuid())
  course      String   // 'basic' | 'flow' | 'energy'
  weekNumber  Int
  weekTitle   String?
  weekSubtitle String?
  heroImage   String?
  videoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([course, weekNumber])
  @@index([course])
}
