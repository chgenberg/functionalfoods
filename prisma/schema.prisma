generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  password      String
  role          String         @default("customer")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastLogin     DateTime?
  isActive      Boolean        @default(true)
  achievements  Achievement[]
  blogPosts     BlogPost[]
  courses       Course[]
  healthMetrics HealthMetric[]
  quizResults   QuizResult[]
  chatMessages  ChatMessage[]
  healthProfile HealthProfile?
  symptomAnalyses SymptomAnalysis[]
  purchases     Purchase[]
  orders        Order[]
  goals         Goal[]
  forumThreads  ForumThread[]
  forumReplies  ForumReply[]
  forumLikes    ForumLike[]
  recipes       Recipe[]
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String
  level       String
  duration    String
  progress    Int      @default(0)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Achievement {
  id          String    @id @default(uuid())
  title       String
  description String
  icon        String
  earned      Boolean   @default(false)
  earnedAt    DateTime?
  userId      String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
}

model HealthMetric {
  id        String   @id @default(uuid())
  type      String
  value     Float
  date      DateTime @default(now())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model BlogPost {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  content      String
  excerpt      String?
  coverImage   String?
  published    Boolean  @default(false)
  publishedAt  DateTime?
  authorId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       User     @relation(fields: [authorId], references: [id])
}

model QuizResult {
  id              String   @id @default(uuid())
  userId          String
  healthScore     Int
  energyScore     Int
  sleepScore      Int
  stressScore     Int
  dietScore       Int
  exerciseScore   Int
  recommendations Json     // Array av rekommendationer
  completedAt     DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  message   String
  response  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model HealthProfile {
  id                String   @id @default(uuid())
  age               Int?
  gender            String?
  weight            Float?
  height            Float?
  activityLevel     String?
  dietaryRestrictions String?
  healthGoals       Json?    // Array av hälsomål
  currentSymptoms   Json?    // Array av nuvarande symptom
  medications       Json?    // Array av mediciner
  supplements       Json?    // Array av kosttillskott
  allergies         Json?    // Array av allergier
  userId            String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}

model SymptomAnalysis {
  id          String   @id @default(uuid())
  bodyPart    String
  description String
  analysis    Json     // AI-genererad analys
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model CourseProduct {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  price       Float
  content     Json     // Stores videos, pdfs, etc.
  features    Json     // List of features included
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchases   Purchase[]
  orderItems  OrderItem[]
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique // Human readable order number
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING)
  totalAmount   Float
  currency      String      @default("SEK")
  items         OrderItem[]
  payment       Payment?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@index([userId])
  @@index([orderNumber])
}

model OrderItem {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courseId    String?
  course      CourseProduct? @relation(fields: [courseId], references: [id])
  name        String        // Store name for historical purposes
  price       Float         // Store price at time of purchase
  quantity    Int
  type        String        // 'course', 'book', etc.
  createdAt   DateTime      @default(now())
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod   String        // 'klarna', 'swish', 'stripe', etc.
  status          PaymentStatus @default(PENDING)
  amount          Float
  currency        String        @default("SEK")
  externalId      String?       // Payment provider's transaction ID
  gatewayResponse Json?         // Store full response from payment gateway
  failureReason   String?       // If payment failed
  processedAt     DateTime?     // When payment was completed
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([externalId])
  @@index([status])
}

model Purchase {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  courseId   String
  course     CourseProduct @relation(fields: [courseId], references: [id])
  amount     Float
  status     String   @default("completed") // completed, pending, refunded
  orderId    String?  // Link to new Order system
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([userId, courseId])
}

model Goal {
  id          String    @id @default(uuid())
  title       String
  description String?
  category    String    // 'weekly', 'health', 'nutrition', 'exercise', 'general'
  priority    String    @default("medium") // 'low', 'medium', 'high'
  status      String    @default("active") // 'active', 'completed', 'paused', 'cancelled'
  progress    Int       @default(0) // 0-100
  targetDate  DateTime?
  completedAt DateTime?
  weekNumber  Int?      // For course-specific weekly goals
  courseId    String?   // Link to specific course
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([weekNumber])
}

model ForumCategory {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  color       String      @default("gray") // For UI theming
  icon        String?     // Icon name
  order       Int         @default(0) // For sorting
  isActive    Boolean     @default(true)
  threads     ForumThread[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ForumThread {
  id          String        @id @default(uuid())
  title       String
  content     String
  isSticky    Boolean       @default(false) // Sticky threads appear at top
  isLocked    Boolean       @default(false) // Locked threads can't receive replies
  views       Int           @default(0)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId  String
  category    ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  replies     ForumReply[]
  likes       ForumLike[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt])
}

model ForumReply {
  id        String      @id @default(uuid())
  content   String
  authorId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parentId  String?     // For nested replies
  parent    ForumReply? @relation("ReplyToReply", fields: [parentId], references: [id], onDelete: Cascade)
  children  ForumReply[] @relation("ReplyToReply")
  likes     ForumLike[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  
  @@index([threadId])
  @@index([authorId])
  @@index([parentId])
}

model ForumLike {
  id       String      @id @default(uuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId String?
  thread   ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  replyId  String?
  reply    ForumReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  
  @@unique([userId, threadId])
  @@unique([userId, replyId])
  @@index([userId])
}

model Recipe {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  excerpt      String?
  content      String?  // Full recipe content/instructions
  imageUrl     String?
  imageAlt     String?
  categories   String[] // Array of category names
  ingredients  String[] // Array of ingredients
  instructions String?  // Cooking instructions as text
  difficulty   String?  // Easy, Medium, Hard
  prepTime     String?  // e.g. "15 min"
  cookTime     String?  // e.g. "30 min"
  totalTime    String?  // e.g. "45 min"
  servings     Int?     // Number of servings
  nutrition    Json?    // Nutritional information
  tips         String?  // Cooking tips
  tags         String[] // Array of tags
  status       RecipeStatus @default(PUBLISHED)
  isPremium    Boolean  @default(false)
  isFree       Boolean  @default(true)
  authorId     String?
  author       User?    @relation(fields: [authorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([status])
  @@index([isPremium])
  @@index([isFree])
  @@index([slug])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
