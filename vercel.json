{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "crons": [
    {
      "path": "/api/cron/publish-posts",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/auto-blog",
      "schedule": "0 */3 8-18 * * *"
    }
  ]
} 